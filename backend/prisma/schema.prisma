datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Organization {
  id               String       @id @default(uuid())
  name             String
  countryCode      String?      @map("country_code") @db.Char(3)
  region           String?
  organizationType String?      @map("organization_type")
  isActive         Boolean      @default(true) @map("is_active")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  users            User[]
  assessments      Assessment[]
  auditLogs        AuditLog[]

  @@map("organizations")
}

model User {
  id                  String          @id @default(uuid())
  organizationId      String?         @map("organization_id")
  organization        Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  email               String          @unique
  passwordHash        String          @map("password_hash")
  fullName            String          @map("full_name")
  role                String          // 'super_admin','admin','assessor','reviewer','viewer'
  isActive            Boolean         @default(true) @map("is_active")
  lastLoginAt         DateTime?       @map("last_login_at")
  failedLoginAttempts Int             @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?       @map("locked_until")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  
  createdAssessments  Assessment[]    @relation("CreatedBy")
  assessorAssessments Assessment[]    @relation("AssignedAssessor")
  reviewerAssessments Assessment[]    @relation("AssignedReviewer")
  approvedAssessments Assessment[]    @relation("ApprovedBy")
  responses           Response[]
  evidenceFiles       EvidenceFile[]
  reviewComments      ReviewComment[]
  reports             Report[]
  auditLogs           AuditLog[]

  @@map("users")
}

model Domain {
  id             String           @id @default(uuid())
  code           String           @unique // e.g. 'LG', 'FIN', 'WF', 'SUP', 'OUT'
  name           String
  displayOrder   Int              @map("display_order")
  description    String?
  createdAt      DateTime         @default(now()) @map("created_at")
  components     Component[]
  computedScores ComputedScore[]

  @@map("domains")
}

model Component {
  id             String           @id @default(uuid())
  domainId       String           @map("domain_id")
  domain         Domain           @relation(fields: [domainId], references: [id], onDelete: Cascade)
  code           String           @unique // e.g. 'C01', 'C02' ... 'C10'
  name           String           @db.VarChar(500)
  description    String?
  displayOrder   Int              @map("display_order")
  referenceText  String?          @map("reference_text")
  createdAt      DateTime         @default(now()) @map("created_at")
  criteria       Criterion[]
  computedScores ComputedScore[]

  @@map("components")
}

model Criterion {
  id             String           @id @default(uuid())
  componentId    String           @map("component_id")
  component      Component        @relation(fields: [componentId], references: [id], onDelete: Cascade)
  code           String           @unique // e.g. 'C01.1', 'C01.2', 'C01.3'
  name           String           @db.VarChar(500)
  displayOrder   Int              @map("display_order")
  createdAt      DateTime         @default(now()) @map("created_at")
  levels         CriterionLevel[]
  responses      Response[]
  reviewComments ReviewComment[]

  @@map("criteria")
}

model CriterionLevel {
  id          String    @id @default(uuid())
  criteriaId  String    @map("criteria_id")
  criterion   Criterion @relation(fields: [criteriaId], references: [id], onDelete: Cascade)
  level       Int       // 0 to 4
  label       String    // 'Non-Existent', 'Emerging', etc.
  description String
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([criteriaId, level])
  @@map("criteria_levels")
}

model MaturityBand {
  id               String       @id @default(uuid())
  label            String       @unique // 'Nascent', 'Emerging', etc.
  minScore         Decimal      @map("min_score") @db.Decimal(5, 2)
  maxScore         Decimal      @map("max_score") @db.Decimal(5, 2)
  systemAttributes String?      @map("system_attributes")
  displayOrder     Int          @map("display_order")
  assessments      Assessment[]

  @@map("maturity_bands")
}

model Assessment {
  id                String          @id @default(uuid())
  organizationId    String          @map("organization_id")
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy         String?         @map("created_by")
  creator           User?           @relation("CreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  assignedAssessorId String?        @map("assigned_assessor")
  assignedAssessor  User?           @relation("AssignedAssessor", fields: [assignedAssessorId], references: [id], onDelete: SetNull)
  assignedReviewerId String?        @map("assigned_reviewer")
  assignedReviewer  User?           @relation("AssignedReviewer", fields: [assignedReviewerId], references: [id], onDelete: SetNull)
  cycleName         String          @map("cycle_name")
  assessmentPeriod  String?         @map("assessment_period")
  assessmentType    String          @default("national") @map("assessment_type")
  status            String          @default("draft") // 'draft','in_progress','under_review','revision_requested','approved','archived'
  chpmiScore        Decimal?        @map("chpmi_score") @db.Decimal(5, 2)
  maturityBandId    String?         @map("maturity_band_id")
  maturityBand      MaturityBand?   @relation(fields: [maturityBandId], references: [id], onDelete: SetNull)
  submittedAt       DateTime?       @map("submitted_at")
  approvedAt        DateTime?       @map("approved_at")
  approvedBy        String?         @map("approved_by")
  approver          User?           @relation("ApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)
  notes             String?
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  
  responses         Response[]
  computedScores    ComputedScore[]
  evidenceFiles     EvidenceFile[]
  reviewComments    ReviewComment[]
  reports           Report[]
  auditLogs         AuditLog[]

  @@map("assessments")
}

model Response {
  id             String         @id @default(uuid())
  assessmentId   String         @map("assessment_id")
  assessment     Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  criteriaId     String         @map("criteria_id")
  criterion      Criterion      @relation(fields: [criteriaId], references: [id], onDelete: Restrict)
  score          Int?           // 0 to 4
  justification  String?
  componentScore Decimal?       @map("component_score") @db.Decimal(5, 4)
  scoredById     String?        @map("scored_by")
  scoredBy       User?          @relation(fields: [scoredById], references: [id], onDelete: SetNull)
  scoredAt       DateTime?      @map("scored_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  evidenceFiles  EvidenceFile[]

  @@unique([assessmentId, criteriaId])
  @@map("responses")
}

model ComputedScore {
  id             String     @id @default(uuid())
  assessmentId   String     @map("assessment_id")
  assessment     Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  componentId    String     @map("component_id")
  component      Component  @relation(fields: [componentId], references: [id], onDelete: Restrict)
  domainId       String     @map("domain_id")
  domain         Domain     @relation(fields: [domainId], references: [id], onDelete: Restrict)
  componentScore Decimal?   @map("component_score") @db.Decimal(5, 4)
  domainScorePct Decimal?   @map("domain_score_pct") @db.Decimal(5, 2)
  updatedAt      DateTime   @default(now()) @map("updated_at")

  @@unique([assessmentId, componentId])
  @@map("computed_scores")
}

model EvidenceFile {
  id              String     @id @default(uuid())
  assessmentId    String     @map("assessment_id")
  assessment      Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  responseId      String     @map("response_id")
  response        Response   @relation(fields: [responseId], references: [id], onDelete: Cascade)
  uploadedById    String?    @map("uploaded_by")
  uploadedBy      User?      @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  fileName        String     @map("file_name") @db.VarChar(500)
  fileTitle       String?    @map("file_title") @db.VarChar(500)
  fileDescription String?    @map("file_description")
  fileType        String?    @map("file_type")
  fileSizeBytes   BigInt?    @map("file_size_bytes")
  storageKey      String     @map("storage_key") @db.VarChar(1000)
  storageUrl      String?    @map("storage_url")
  uploadedAt      DateTime   @default(now()) @map("uploaded_at")

  @@map("evidence_files")
}

model ReviewComment {
  id           String      @id @default(uuid())
  assessmentId String      @map("assessment_id")
  assessment   Assessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  criteriaId   String?     @map("criteria_id")
  criterion    Criterion?  @relation(fields: [criteriaId], references: [id], onDelete: Cascade)
  commentedById String?    @map("commented_by")
  commentedBy  User?       @relation(fields: [commentedById], references: [id], onDelete: SetNull)
  comment      String
  commentType  String      @default("review") @map("comment_type") // 'review','revision_request','approval_note'
  createdAt    DateTime    @default(now()) @map("created_at")

  @@map("review_comments")
}

model Report {
  id           String     @id @default(uuid())
  assessmentId String     @map("assessment_id")
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  generatedById String?    @map("generated_by")
  generatedBy  User?      @relation(fields: [generatedById], references: [id], onDelete: SetNull)
  reportType   String     @map("report_type") // 'pdf','excel','comparative'
  storageKey   String?    @map("storage_key") @db.VarChar(1000)
  generatedAt  DateTime   @default(now()) @map("generated_at")

  @@map("reports")
}

model AuditLog {
  id             String        @id @default(uuid())
  userId         String?       @map("user_id")
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  assessmentId   String?       @map("assessment_id")
  assessment     Assessment?   @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  action         String        @db.VarChar(100)
  entityType     String?       @map("entity_type")
  entityId       String?       @map("entity_id")
  previousValue  Json?         @map("previous_value")
  newValue       Json?         @map("new_value")
  ipAddress      String?       @map("ip_address")
  userAgent      String?       @map("user_agent")
  createdAt      DateTime      @default(now()) @map("created_at")

  @@map("audit_logs")
}
