# ============================================================
# Backend Environment Variables — Vercel Production
# ============================================================
# Copy this file and rename to .env.production.local for local
# testing, or add each variable in Vercel Dashboard → Settings
# → Environment Variables.
# ============================================================

# Vercel sets PORT automatically — do not set it manually
NODE_ENV=production

# Neon PostgreSQL connection string
# Format: postgresql://username:password@hostname/databasename?sslmode=require
DATABASE_URL=""

# CORS — the deployed frontend URL (comma-separated for multiple origins)
# Example: https://chp-frontend.vercel.app
FRONTEND_URL=""

# RS256 JWT Key-pair (PEM format, replace literal newlines with \n)
# The keys/ directory files are used as fallback in dev, but on Vercel
# you MUST set these env vars for reliable JWT operation.
# To convert your existing key files to single-line env values:
#   cat keys/jwt.key | tr '\n' '|' | sed 's/|/\\n/g'
#   cat keys/jwt.key.pub | tr '\n' '|' | sed 's/|/\\n/g'
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""

# Storage (local = ephemeral on Vercel; use s3 for persistent uploads)
STORAGE_PROVIDER=local
UPLOAD_DIR="./uploads"

# S3 — only needed if STORAGE_PROVIDER=s3
# S3_BUCKET_NAME=""
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

# ClamAV antivirus scanning (optional, skip if not configured)
# CLAMAV_HOST=""

# SMTP (optional, for email notifications)
# SMTP_HOST=""
# SMTP_PORT=""
# SMTP_USER=""
# SMTP_PASS=""
